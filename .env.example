# Local development only. Use HTTPS for APP_URL in production.
APP_URL=http://localhost:3000
TENANTS_CONFIG_FILE=/absolute/path/to/your/tenants.json
DIAGNOSTICS_DATA_DIR=.data

# Required for browser OIDC sign-in. Omit all three for API-key-only local use.
OIDC_ISSUER=https://id.example.com/realms/diagnostics
OIDC_CLIENT_ID=diagnostics
OIDC_CLIENT_SECRET=REPLACE_WITH_YOUR_CLIENT_SECRET
OIDC_GROUPS_CLAIM=groups
OIDC_SCOPES=openid profile email

# Optional provider credentials. Each tenant must also set allowAi: true.
# GROQ_API_KEY=
# OPENAI_API_KEY=
